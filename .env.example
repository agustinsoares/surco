# --- Base local (implementación actual) ---
# Secreto para firmar la cookie de sesión. Obligatorio en producción
# (generalo con: openssl rand -base64 32).
AUTH_SECRET=cambia-esto-por-un-secreto-largo
# Cuenta de administrador que se crea al generar la base local por primera vez.
ADMIN_EMAIL=admin@surco.local
ADMIN_PASSWORD=cambia-esta-contrasena
# Opcional: ruta del archivo JSON (por defecto .data/db.json; en Vercel /tmp/surco-db.json).
# LOCAL_DB_PATH=.data/db.json

# --- Supabase (desactivado, ver docs/datos-supabase.md) ---
# NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
